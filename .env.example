# Copy to .env.local and fill in. Names only here — never commit real values.

# Supabase → Project Settings → API Keys (new keys, not the legacy anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, bypasses RLS. Used by scripts (backup, restore, auth:set-password) and by the server-side
# Google Calendar and bank syncs (lib/google, lib/bank, lib/supabase/admin.ts) — never in the browser.
SUPABASE_SECRET_KEY=

# The only email that may log in to Chalk.
ALLOWED_EMAIL=

# Local development only (never set on Vercel): Adomas's password, at least 12 characters.
# `npm run auth:set-password` sets it in Supabase; `npm run dev` on localhost then logs in automatically.
DEV_LOGIN_PASSWORD=

# Google Calendar (Phase 2) — Google Cloud project "chalk" → Google Auth Platform → Clients → Web application.
# Redirect URIs: http://localhost:3000/api/google/callback and https://chalk-adomas.vercel.app/api/google/callback. Server only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bank import via Enable Banking (Phase 3) — enablebanking.com → Control Panel → API applications (Production, restricted).
# Server only, never in git or chat. The private key is the .pem file the Control Panel downloads; paste it as a
# multi-line value (Vercel accepts it as is; in .env.local wrap it in double quotes), or as one line with "\n" escapes,
# or base64 of the whole file. Redirect URLs: http://localhost:3000/api/bank/callback and
# https://chalk-adomas.vercel.app/api/bank/callback.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# The bank (ASPSP) to connect, exactly as Enable Banking lists it (GET /aspsps?country=…), and its ISO country code.
BANK_ASPSP_NAME=
BANK_ASPSP_COUNTRY=

# Vercel only: random string (32+ characters). Vercel Cron sends it as "Authorization: Bearer …" to
# /api/cron/sync (daily Google Calendar safety net + bank sync, vercel.json). Not needed locally.
CRON_SECRET=
